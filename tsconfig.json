{
    "compilerOptions": {
      "target": "ES2022",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "strict": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "types": ["node", "@playwright/test"],
      "skipLibCheck": true
    },
    "include": [
      "config",
      "fixtures",
      "pages",
      "tests",
      "utils",
      "*.ts"
    ]
  }